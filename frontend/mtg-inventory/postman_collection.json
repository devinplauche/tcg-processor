            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/inventory/import",
              "host": ["{{base_url}}"],
              "path": ["api", "inventory", "import"]
            },
            "description": "Upload and import CSV from ManaBox"
          },
          "response": []
        }
      ]
    },
