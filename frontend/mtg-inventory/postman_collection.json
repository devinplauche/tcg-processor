            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 100,\n  \"force\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pricing/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "pricing", "refresh"]
            },
            "description": "Queue price refresh job (requires auth)"
