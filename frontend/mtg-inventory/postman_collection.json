{
  "info": {
    "_postman_id": "mtg-inventory-api",
    "name": "MTG Inventory API",
    "description": "MTG Inventory System API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            },
            "description": "Verify API is online and database connected"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Search Cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cards/search?q=Ragavan&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "cards", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "Ragavan",
                  "description": "Search query (min 2 chars)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Result limit (default 10, max 100)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "set",
                  "value": "MH2",
                  "disabled": true
                },
                {
                  "key": "foil",
                  "value": "false",
                  "disabled": true
                },
                {
                  "key": "condition",
                  "value": "NM",
                  "disabled": true
                },
                {
                  "key": "min_price",
                  "value": "10.00",
                  "disabled": true
                },
                {
                  "key": "max_price",
                  "value": "100.00",
                  "disabled": true
                }
              ]
            },
            "description": "Search cards by name, set, condition, price"
          },
          "response": []
        },
        {
          "name": "Get Card by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cards/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cards", "1"]
            },
            "description": "Get detailed card information"
          },
          "response": []
        },
        {
          "name": "List All Cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cards?limit=20&offset=0&sort=created_at&order=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "cards"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "sort",
                  "value": "created_at"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            },
            "description": "List all cards with pagination"
          },
          "response": []
        },
        {
          "name": "Update Card",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"condition\": \"LP\",\n  \"foil\": true,\n  \"quantity\": 2,\n  \"purchase_price\": 45.00,\n  \"list_on_ebay\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/cards/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cards", "1"]
            },
            "description": "Update card information (requires auth)"
          },
          "response": []
        },
        {
          "name": "Delete Card",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/cards/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cards", "1"]
            },
            "description": "Delete a card from inventory (requires admin auth)"
          },
          "response": []
        }
      ]
