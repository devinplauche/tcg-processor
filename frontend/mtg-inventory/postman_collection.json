            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/boxes/1/qr",
              "host": ["{{base_url}}"],
              "path": ["api", "boxes", "1", "qr"]
            },
            "description": "Generate QR code for box (requires auth)"
          },
          "response": []
        }
      ]
