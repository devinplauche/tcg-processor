            "url": {
              "raw": "{{base_url}}/api/boxes/1?limit=20&offset=0&sort=slot",
              "host": ["{{base_url}}"],
              "path": ["api", "boxes", "1"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "sort",
                  "value": "slot",
                  "description": "slot, name, or created_at"
                }
              ]
            },
            "description": "Get specific box with all contained cards"
          },
          "response": []
        },
