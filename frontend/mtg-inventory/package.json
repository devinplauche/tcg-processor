{
  "name": "mtg-inventory-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Cypress e2e harness for full-stack MTG app",
  "config": {
    "backend_dir": "../../backend/services/mtg-api-gateway"
  },
  "scripts": {
    "serve:frontend": "python app.py",
    "serve:backend": "cd ${BACKEND_DIR:-$npm_package_config_backend_dir} && mvn -q spring-boot:run",
    "cypress:e2e": "wait-on http://localhost:5000 http://localhost:8080/api/v1/health && cypress run",
    "e2e:fullstack": "concurrently -k -s last \"npm:serve:frontend\" \"npm:serve:backend\" \"npm:cypress:e2e\"",
    "fullstack": "concurrently -k -s first \"npm:serve:frontend\" \"npm:serve:backend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cypress": "^13.15.0",
    "wait-on": "^8.0.0"
  }
}
