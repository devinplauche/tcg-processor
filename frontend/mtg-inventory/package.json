{
  "name": "mtg-inventory-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Cypress e2e harness for full-stack MTG app",
  "scripts": {
    "serve:frontend": "c:/Users/devinsGamingPC/Coding/tcg-processor/.venv/Scripts/python.exe app.py",
    "serve:backend": "cd ../../backend/services/mtg-api-gateway && mvn -q spring-boot:run",
    "cypress:e2e": "wait-on http://localhost:5000 http://localhost:8080/api/v1/health && cypress run",
    "e2e:fullstack": "concurrently -k -s first \"npm:serve:frontend\" \"npm:serve:backend\" \"npm:cypress:e2e\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cypress": "^13.15.0",
    "wait-on": "^8.0.0"
  }
}
